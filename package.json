{
  "name": "samzersql",
  "version": "1.0.3",
  "description": "Cross-platform desktop SQL client for Snowflake, MySQL, and PostgreSQL",
  "author": "Samir Madhavan",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7",
    "@codemirror/view": "^6.22.0",
    "@codemirror/state": "^6.3.0",
    "@codemirror/lang-sql": "^6.5.0",
    "@codemirror/autocomplete": "^6.11.0",
    "@codemirror/commands": "^6.3.0",
    "@codemirror/language": "^6.9.0",
    "@codemirror/search": "^6.5.0",
    "pg": "^8.11.3",
    "mysql2": "^3.6.5",
    "snowflake-sdk": "^1.9.3",
    "uuid": "^9.0.0",
    "sql-formatter": "^13.0.0",
    "@tanstack/react-virtual": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "build": {
    "appId": "com.samzersql.app",
    "productName": "samzerSQL",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
